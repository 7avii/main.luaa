local function CreateJArrow(data)
    local btn = Instance.new("ImageButton", jMainFrame)
    btn.Name = data.n
    btn.Size = UDim2.new(0.22, 0, 0.22, 0)
    btn.Position = data.p
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.Rotation = data.r
    btn.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
    btn.Image = "rbxassetid://7072706663"
    btn.BackgroundTransparency = 0.1
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    local bStroke = Instance.new("UIStroke", btn)
    bStroke.Color = Theme.Gold
    bStroke.Thickness = 1.5

    -- سحب في وضع التعديل فقط
    local jDrg, jDrgIn, jDrgSt, jDrgPos
    btn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and jEditMode then
            jDrg = true
            jDrgSt = input.Position
            jDrgPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then jDrg = false end
            end)
        end
    end)
    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            jDrgIn = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == jDrgIn and jDrg and jEditMode then
            local d = input.Position - jDrgSt
            btn.Position = UDim2.new(jDrgPos.X.Scale, jDrgPos.X.Offset + d.X, jDrgPos.Y.Scale, jDrgPos.Y.Offset + d.Y)
        end
    end)

    -- حركة مستمرة عند الضغط المطوّل (خارج وضع التعديل فقط)
    local holding = false
    btn.InputBegan:Connect(function(input)
        if not jEditMode and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            holding = true
        end
    end)
    btn.InputEnded:Connect(function() holding = false end)
    RunService.RenderStepped:Connect(function()
        if holding and not jEditMode then
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum:Move(data.mv, true) end
        end
    end)
    table.insert(jArrows, btn)
end

for _, d in ipairs(jArrowDefaults) do
    CreateJArrow(d)
end


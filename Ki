    end

    local warningArabic = Instance.new("TextLabel", bg)
    warningArabic.Size = UDim2.new(1, 0, 0.05, 0)
    warningArabic.Position = UDim2.new(0, 0, 0.65, 0)
    warningArabic.BackgroundTransparency = 1

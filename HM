-- rainbow
local rblist = {
Color3.fromRGB(160,80,255),
Color3.fromRGB(80,140,255),
Color3.fromRGB(0,200,220),
Color3.fromRGB(0,210,120),
Color3.fromRGB(200,230,0),
Color3.fromRGB(255,140,0),
Color3.fromRGB(255,60,100),
}
local rbreg = {}
local rbt = 0

local function addrb(o,p) table.insert(rbreg,{o=o,p=p}) end

local function getrb(t)
local i = math.floor(t%#rblist)+1
local n = (i%#rblist)+1
local f = t%1
local a,b = rblist[i],rblist[n]
return Color3.new(a.R+(b.R-a.R)*f,a.G+(b.G-a.G)*f,a.B+(b.B-a.B)*f)
end

run.RenderStepped:Connect(function(dt)
rbt = rbt+dt*0.45
local c = getrb(rbt)
for _,e in ipairs(rbreg) do
if e.o and e.o.Parent then e.o[e.p]=c end
end
end)

